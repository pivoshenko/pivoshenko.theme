theme:
  activeBorderColor:
    - "{{ role.accent.primary.hex }}"
    - bold
  inactiveBorderColor:
    - "{{ role.fg.subtle.hex }}"
  optionsTextColor:
    - "{{ role.accent.primary.hex }}"
  selectedLineBgColor:
    - "{{ role.bg.surface.hex }}"
  cherryPickedCommitBgColor:
    - "{{ role.bg.raised.hex }}"
  cherryPickedCommitFgColor:
    - "{{ role.accent.primary.hex }}"
  unstagedChangesColor:
    - "{{ role.accent.danger.hex }}"
  defaultFgColor:
    - "{{ role.fg.default.hex }}"
  searchingActiveBorderColor:
    - "{{ role.accent.warning.hex }}"

authorColors:
  "*": "{{ lavender.hex }}"
