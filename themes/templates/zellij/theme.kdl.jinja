themes {
  {{ name }} {
    // == Status / mode bar text ==
    text_unselected {
      base "{{ role.fg.muted.hex }}"
      background "{{ role.bg.sunken.hex }}"
      emphasis_0 "{{ role.accent.primary.hex }}"
      emphasis_1 "{{ role.accent.info.hex }}"
      emphasis_2 "{{ role.accent.success.hex }}"
      emphasis_3 "{{ role.accent.secondary.hex }}"
    }
    text_selected {
      base "{{ role.fg.default.hex }}"
      background "{{ role.bg.raised.hex }}"
      emphasis_0 "{{ role.accent.primary.hex }}"
      emphasis_1 "{{ role.accent.info.hex }}"
      emphasis_2 "{{ role.accent.success.hex }}"
      emphasis_3 "{{ role.accent.secondary.hex }}"
    }

    // == Tabs (ribbons) ==
    // active tab: bright accent, prominent
    ribbon_selected {
      base "{{ role.bg.sunken.hex }}"
      background "{{ role.accent.primary.hex }}"
      emphasis_0 "{{ role.bg.sunken.hex }}"
      emphasis_1 "{{ role.accent.info.hex }}"
      emphasis_2 "{{ role.accent.success.hex }}"
      emphasis_3 "{{ role.accent.secondary.hex }}"
    }
    // inactive tab: muted chip
    // emphasis_1 is the tab-bar "alternate tab" colour (zebra striping) -- keep
    // it a subtle bg step so every other tab doesn't turn a loud accent colour
    ribbon_unselected {
      base "{{ role.fg.muted.hex }}"
      background "{{ role.bg.surface.hex }}"
      emphasis_0 "{{ role.accent.primary.hex }}"
      emphasis_1 "{{ role.bg.raised.hex }}"
      emphasis_2 "{{ role.accent.success.hex }}"
      emphasis_3 "{{ role.accent.secondary.hex }}"
    }

    // == Tables (session manager, etc.) ==
    table_title {
      base "{{ role.accent.primary.hex }}"
      background "{{ role.bg.sunken.hex }}"
      emphasis_0 "{{ role.accent.info.hex }}"
      emphasis_1 "{{ role.accent.success.hex }}"
      emphasis_2 "{{ role.accent.secondary.hex }}"
      emphasis_3 "{{ role.accent.danger.hex }}"
    }
    table_cell_selected {
      base "{{ role.fg.default.hex }}"
      background "{{ role.bg.raised.hex }}"
      emphasis_0 "{{ role.accent.primary.hex }}"
      emphasis_1 "{{ role.accent.info.hex }}"
      emphasis_2 "{{ role.accent.success.hex }}"
      emphasis_3 "{{ role.accent.secondary.hex }}"
    }
    table_cell_unselected {
      base "{{ role.fg.muted.hex }}"
      background "{{ role.bg.sunken.hex }}"
      emphasis_0 "{{ role.accent.primary.hex }}"
      emphasis_1 "{{ role.accent.info.hex }}"
      emphasis_2 "{{ role.accent.success.hex }}"
      emphasis_3 "{{ role.accent.secondary.hex }}"
    }

    // == Lists (fuzzy finders, pickers) ==
    list_selected {
      base "{{ role.fg.default.hex }}"
      background "{{ role.bg.raised.hex }}"
      emphasis_0 "{{ role.accent.primary.hex }}"
      emphasis_1 "{{ role.accent.info.hex }}"
      emphasis_2 "{{ role.accent.success.hex }}"
      emphasis_3 "{{ role.accent.secondary.hex }}"
    }
    list_unselected {
      base "{{ role.fg.muted.hex }}"
      background "{{ role.bg.sunken.hex }}"
      emphasis_0 "{{ role.accent.primary.hex }}"
      emphasis_1 "{{ role.accent.info.hex }}"
      emphasis_2 "{{ role.accent.success.hex }}"
      emphasis_3 "{{ role.accent.secondary.hex }}"
    }

    // == Pane frames ==
    frame_selected {
      base "{{ role.accent.primary.hex }}"
      background "{{ role.bg.sunken.hex }}"
      emphasis_0 "{{ role.accent.secondary.hex }}"
      emphasis_1 "{{ role.accent.info.hex }}"
      emphasis_2 "{{ role.accent.success.hex }}"
      emphasis_3 "{{ role.accent.danger.hex }}"
    }
    frame_highlight {
      base "{{ role.accent.secondary.hex }}"
      background "{{ role.bg.sunken.hex }}"
      emphasis_0 "{{ role.accent.primary.hex }}"
      emphasis_1 "{{ role.accent.info.hex }}"
      emphasis_2 "{{ role.accent.success.hex }}"
      emphasis_3 "{{ role.accent.danger.hex }}"
    }

    // == Exit codes ==
    exit_code_success {
      base "{{ role.accent.success.hex }}"
      background "{{ role.bg.sunken.hex }}"
      emphasis_0 "{{ role.accent.info.hex }}"
      emphasis_1 "{{ role.accent.primary.hex }}"
      emphasis_2 "{{ role.accent.secondary.hex }}"
      emphasis_3 "{{ role.accent.danger.hex }}"
    }
    exit_code_error {
      base "{{ role.accent.danger.hex }}"
      background "{{ role.bg.sunken.hex }}"
      emphasis_0 "{{ role.accent.secondary.hex }}"
      emphasis_1 "{{ role.accent.info.hex }}"
      emphasis_2 "{{ role.accent.success.hex }}"
      emphasis_3 "{{ role.accent.primary.hex }}"
    }

    // == Collaborators ==
    multiplayer_user_colors {
      player_1 "{{ role.accent.primary.hex }}"
      player_2 "{{ role.accent.info.hex }}"
      player_3 "{{ role.accent.success.hex }}"
      player_4 "{{ pink.hex }}"
      player_5 "{{ role.accent.secondary.hex }}"
      player_6 "{{ lavender.hex }}"
      player_7 "{{ role.accent.danger.hex }}"
      player_8 "{{ teal.hex }}"
      player_9 "{{ sky.hex }}"
      player_10 "{{ rosewater.hex }}"
    }
  }
}
