# {{ name }} — tmux theme

set -g status-style "fg={{ role.fg.muted.hex }},bg={{ role.bg.sunken.hex }}"
set -g status-left-style "fg={{ role.accent.primary.hex }},bg={{ role.bg.sunken.hex }},bold"
set -g status-right-style "fg={{ role.fg.subtle.hex }},bg={{ role.bg.sunken.hex }}"

set -g window-status-style "fg={{ role.fg.subtle.hex }},bg={{ role.bg.sunken.hex }}"
set -g window-status-current-style "fg={{ role.bg.canvas.hex }},bg={{ role.accent.primary.hex }},bold"
set -g window-status-activity-style "fg={{ role.accent.warning.hex }},bg={{ role.bg.sunken.hex }}"
set -g window-status-bell-style "fg={{ role.accent.danger.hex }},bg={{ role.bg.sunken.hex }},bold"
set -g window-status-separator ""

set -g pane-border-style "fg={{ role.border.subtle.hex }}"
set -g pane-active-border-style "fg={{ role.accent.primary.hex }}"

set -g message-style "fg={{ role.fg.default.hex }},bg={{ role.bg.raised.hex }}"
set -g message-command-style "fg={{ role.fg.default.hex }},bg={{ role.bg.raised.hex }}"

set -g mode-style "fg={{ role.bg.canvas.hex }},bg={{ role.accent.secondary.hex }},bold"

set -g copy-mode-match-style "fg={{ role.bg.canvas.hex }},bg={{ role.accent.info.hex }}"
set -g copy-mode-current-match-style "fg={{ role.bg.canvas.hex }},bg={{ role.accent.primary.hex }},bold"

set -g clock-mode-colour "{{ role.accent.primary.hex }}"

set -g display-panes-colour "{{ role.fg.faint.hex }}"
set -g display-panes-active-colour "{{ role.accent.primary.hex }}"
