{%- macro c(color) -%}38;2;{{ color | rgb | replace(', ', ';') }}{%- endmacro -%}
{%- set types = [
  'no=' ~ c(role.fg.default),
  'fi=' ~ c(role.fg.default),
  'di=1;' ~ c(role.accent.info),
  'ln=' ~ c(teal),
  'mh=' ~ c(role.fg.subtle),
  'pi=' ~ c(yellow),
  'so=' ~ c(pink),
  'do=' ~ c(pink),
  'bd=' ~ c(peach),
  'cd=' ~ c(peach),
  'or=1;' ~ c(role.accent.danger),
  'mi=' ~ c(role.accent.danger),
  'su=1;' ~ c(role.accent.danger),
  'sg=1;' ~ c(role.accent.warning),
  'ca=' ~ c(mauve),
  'tw=' ~ c(role.accent.info),
  'ow=' ~ c(role.accent.info),
  'st=' ~ c(role.accent.info),
  'ex=1;' ~ c(role.accent.success),
] -%}
{%- set groups = [
  (role.accent.primary, ['py', 'pyi', 'rs', 'go', 'ts', 'tsx', 'js', 'jsx', 'mjs', 'cjs', 'fish',
                         'sh', 'bash', 'zsh', 'lua', 'rb', 'java', 'kt', 'c', 'h', 'cc', 'cpp',
                         'hpp', 'swift', 'php', 'ex', 'exs', 'hs', 'ml', 'nix', 'jinja', 'vim']),
  (role.accent.secondary, ['json', 'jsonc', 'toml', 'yaml', 'yml', 'ini', 'conf', 'cfg', 'env',
                           'kdl', 'properties', 'plist']),
  (role.accent.danger, ['zip', 'tar', 'tgz', 'gz', 'bz2', 'xz', 'zst', '7z', 'rar', 'dmg', 'pkg',
                        'deb', 'rpm']),
  (role.accent.warning, ['diff', 'patch']),
  (yellow, ['pdf', 'md', 'markdown', 'rst', 'txt', 'epub', 'doc', 'docx', 'odt']),
  (mauve, ['png', 'jpg', 'jpeg', 'gif', 'bmp', 'svg', 'webp', 'avif', 'ico', 'tiff', 'heic']),
  (pink, ['mp4', 'mkv', 'mov', 'webm', 'avi', 'm4v']),
  (sapphire, ['mp3', 'flac', 'wav', 'ogg', 'opus', 'm4a', 'aac']),
  (sky, ['css', 'scss', 'sass', 'less']),
  (teal, ['html', 'htm', 'xml']),
  (role.fg.faint, ['lock', 'log', 'bak', 'tmp', 'swp', 'orig', 'rej']),
] -%}
{%- set extensions = [] -%}
{%- for color, exts in groups -%}
{%- for ext in exts -%}
{%- set _ = extensions.append('*.' ~ ext ~ '=' ~ c(color)) -%}
{%- endfor -%}
{%- endfor -%}
{%- set eza = [
  'reset',
  'ur=' ~ c(role.accent.secondary),
  'uw=' ~ c(role.accent.danger),
  'ux=' ~ c(role.accent.success),
  'ue=' ~ c(role.accent.success),
  'gr=' ~ c(role.accent.secondary),
  'gw=' ~ c(role.accent.danger),
  'gx=' ~ c(role.accent.success),
  'tr=' ~ c(role.accent.secondary),
  'tw=' ~ c(role.accent.danger),
  'tx=' ~ c(role.accent.success),
  'su=' ~ c(role.accent.danger),
  'sf=' ~ c(role.accent.danger),
  'xa=' ~ c(role.fg.subtle),
  'sn=' ~ c(role.fg.muted),
  'sb=' ~ c(role.fg.subtle),
  'df=' ~ c(role.fg.faint),
  'ds=' ~ c(role.fg.faint),
  'uu=' ~ c(role.accent.primary),
  'un=' ~ c(role.fg.subtle),
  'gu=' ~ c(role.fg.muted),
  'gn=' ~ c(role.fg.subtle),
  'lc=' ~ c(role.fg.faint),
  'lm=' ~ c(role.accent.danger),
  'da=' ~ c(role.fg.faint),
  'ga=' ~ c(role.accent.success),
  'gm=' ~ c(role.accent.warning),
  'gd=' ~ c(role.accent.danger),
  'gv=' ~ c(mauve),
  'gt=' ~ c(peach),
  'gi=' ~ c(role.fg.faint),
  'lp=' ~ c(teal),
  'cc=' ~ c(role.accent.danger),
  'bO=' ~ c(role.accent.danger),
  'xx=' ~ c(role.fg.faint),
  'hd=1;' ~ c(role.fg.muted),
] -%}
# {{ name }}
# Generated by pivoshenko.theme - do not edit by hand

# == File Types ==

set -gx LS_COLORS "{{ (types + extensions) | join(':') }}"

# == Eza Columns ==

set -gx EZA_COLORS "{{ eza | join(':') }}"
