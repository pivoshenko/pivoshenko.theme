    "suggestion": "{{ lavender.hex }}",
    "permission": "{{ sapphire.hex }}",
    "permissionShimmer": "{{ sky.hex }}",
    "remember": "{{ mauve.hex }}",
    "success": "{{ role.accent.success.hex }}",
    "error": "{{ role.accent.danger.hex }}",
    "warning": "{{ role.accent.warning.hex }}",
