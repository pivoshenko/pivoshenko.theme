    "diffAddedDimmed": "{{ base | mix(color=green, amount=0.1) | get(key='hex') }}",
    "diffRemovedDimmed": "{{ base | mix(color=red, amount=0.1) | get(key='hex') }}",
    "diffAddedWord": "{{ base | mix(color=green, amount=0.35) | get(key='hex') }}",
    "diffRemovedWord": "{{ base | mix(color=red, amount=0.35) | get(key='hex') }}",
    "userMessageBackground": "{{ role.bg.surface.hex }}",
    "userMessageBackgroundHover": "{{ role.bg.raised.hex }}",
    "bashMessageBackgroundColor": "{{ role.bg.surface.hex }}",
