    "blue_FOR_SUBAGENTS_ONLY": "{{ blue.hex }}",
    "green_FOR_SUBAGENTS_ONLY": "{{ green.hex }}",
    "yellow_FOR_SUBAGENTS_ONLY": "{{ yellow.hex }}",
    "purple_FOR_SUBAGENTS_ONLY": "{{ mauve.hex }}",
