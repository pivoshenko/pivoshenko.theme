k9s:
  body:
    fgColor: "{{ role.fg.default.hex }}"
    bgColor: "{{ role.bg.canvas.hex }}"
    logoColor: "{{ role.accent.info.hex }}"
  prompt:
    fgColor: "{{ role.fg.default.hex }}"
    bgColor: "{{ role.bg.canvas.hex }}"
    suggestColor: "{{ role.accent.info.hex }}"
    border:
      defaultColor: "{{ role.fg.faint.hex }}"
      commandColor: "{{ role.fg.faint.hex }}"
  help:
    fgColor: "{{ role.fg.default.hex }}"
    bgColor: "{{ role.bg.canvas.hex }}"
    sectionColor: "{{ role.accent.success.hex }}"
    keyColor: "{{ role.accent.info.hex }}"
    numKeyColor: "{{ maroon.hex }}"
  frame:
    title:
      fgColor: "{{ teal.hex }}"
      bgColor: "{{ role.bg.canvas.hex }}"
      highlightColor: "{{ pink.hex }}"
      counterColor: "{{ role.accent.warning.hex }}"
      filterColor: "{{ role.accent.success.hex }}"
    border:
      fgColor: "{{ mauve.hex }}"
      focusColor: "{{ lavender.hex }}"
    menu:
      fgColor: "{{ role.fg.default.hex }}"
      keyColor: "{{ role.accent.info.hex }}"
      numKeyColor: "{{ maroon.hex }}"
    crumbs:
      fgColor: "{{ role.bg.canvas.hex }}"
      bgColor: "{{ maroon.hex }}"
      activeColor: "{{ flamingo.hex }}"
    status:
      newColor: "{{ role.accent.info.hex }}"
      modifyColor: "{{ lavender.hex }}"
      addColor: "{{ role.accent.success.hex }}"
      pendingColor: "{{ role.accent.primary.hex }}"
      errorColor: "{{ role.accent.danger.hex }}"
      highlightColor: "{{ sky.hex }}"
      killColor: "{{ mauve.hex }}"
      completedColor: "{{ overlay0.hex }}"
  info:
    fgColor: "{{ role.accent.primary.hex }}"
    sectionColor: "{{ role.fg.default.hex }}"
  views:
    table:
      fgColor: "{{ role.fg.default.hex }}"
      bgColor: "{{ role.bg.canvas.hex }}"
      cursorFgColor: "{{ role.bg.surface.hex }}"
      cursorBgColor: "{{ role.bg.raised.hex }}"
      markColor: "{{ rosewater.hex }}"
      header:
        fgColor: "{{ role.accent.warning.hex }}"
        bgColor: "{{ role.bg.canvas.hex }}"
        sorterColor: "{{ sky.hex }}"
    xray:
      fgColor: "{{ role.fg.default.hex }}"
      bgColor: "{{ role.bg.canvas.hex }}"
      cursorColor: "{{ role.bg.raised.hex }}"
      cursorTextColor: "{{ role.bg.canvas.hex }}"
      graphicColor: "{{ pink.hex }}"
    charts:
      bgColor: "{{ role.bg.canvas.hex }}"
      chartBgColor: "{{ role.bg.canvas.hex }}"
      dialBgColor: "{{ role.bg.canvas.hex }}"
      defaultDialColors:
        - "{{ green.hex }}"
        - "{{ red.hex }}"
      defaultChartColors:
        - "{{ green.hex }}"
        - "{{ red.hex }}"
      resourceColors:
        cpu:
          - "{{ mauve.hex }}"
          - "{{ blue.hex }}"
        mem:
          - "{{ yellow.hex }}"
          - "{{ peach.hex }}"
    yaml:
      keyColor: "{{ role.accent.info.hex }}"
      valueColor: "{{ role.fg.default.hex }}"
      colonColor: "{{ role.fg.subtle.hex }}"
    logs:
      fgColor: "{{ role.fg.default.hex }}"
      bgColor: "{{ role.bg.canvas.hex }}"
      indicator:
        fgColor: "{{ lavender.hex }}"
        bgColor: "{{ role.bg.canvas.hex }}"
        toggleOnColor: "{{ role.accent.success.hex }}"
        toggleOffColor: "{{ role.fg.subtle.hex }}"
  dialog:
    fgColor: "{{ role.accent.warning.hex }}"
    bgColor: "{{ overlay2.hex }}"
    buttonFgColor: "{{ role.bg.canvas.hex }}"
    buttonBgColor: "{{ role.fg.faint.hex }}"
    buttonFocusFgColor: "{{ role.bg.canvas.hex }}"
    buttonFocusBgColor: "{{ pink.hex }}"
    labelFgColor: "{{ rosewater.hex }}"
    fieldFgColor: "{{ role.fg.default.hex }}"
