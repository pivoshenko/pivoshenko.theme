themes {
  popil {
    // == Status / mode bar text ==
    text_unselected {
      base "#b8b3a8"
      background "#1a1a19"
      emphasis_0 "#8da7d1"
      emphasis_1 "#5ba7c5"
      emphasis_2 "#91ab78"
      emphasis_3 "#b8b9d7"
    }
    text_selected {
      base "#e4e2de"
      background "#343230"
      emphasis_0 "#8da7d1"
      emphasis_1 "#5ba7c5"
      emphasis_2 "#91ab78"
      emphasis_3 "#b8b9d7"
    }

    // == Tabs (ribbons) ==
    // active tab: bright accent, prominent
    ribbon_selected {
      base "#1a1a19"
      background "#8da7d1"
      emphasis_0 "#1a1a19"
      emphasis_1 "#5ba7c5"
      emphasis_2 "#91ab78"
      emphasis_3 "#b8b9d7"
    }
    // inactive tab: muted chip
    // emphasis_1 is the tab-bar "alternate tab" colour (zebra striping) -- keep
    // it a subtle bg step so every other tab doesn't turn a loud accent colour
    ribbon_unselected {
      base "#b8b3a8"
      background "#2b2926"
      emphasis_0 "#8da7d1"
      emphasis_1 "#343230"
      emphasis_2 "#91ab78"
      emphasis_3 "#b8b9d7"
    }

    // == Tables (session manager, etc.) ==
    table_title {
      base "#8da7d1"
      background "#1a1a19"
      emphasis_0 "#5ba7c5"
      emphasis_1 "#91ab78"
      emphasis_2 "#b8b9d7"
      emphasis_3 "#ec7470"
    }
    table_cell_selected {
      base "#e4e2de"
      background "#343230"
      emphasis_0 "#8da7d1"
      emphasis_1 "#5ba7c5"
      emphasis_2 "#91ab78"
      emphasis_3 "#b8b9d7"
    }
    table_cell_unselected {
      base "#b8b3a8"
      background "#1a1a19"
      emphasis_0 "#8da7d1"
      emphasis_1 "#5ba7c5"
      emphasis_2 "#91ab78"
      emphasis_3 "#b8b9d7"
    }

    // == Lists (fuzzy finders, pickers) ==
    list_selected {
      base "#e4e2de"
      background "#343230"
      emphasis_0 "#8da7d1"
      emphasis_1 "#5ba7c5"
      emphasis_2 "#91ab78"
      emphasis_3 "#b8b9d7"
    }
    list_unselected {
      base "#b8b3a8"
      background "#1a1a19"
      emphasis_0 "#8da7d1"
      emphasis_1 "#5ba7c5"
      emphasis_2 "#91ab78"
      emphasis_3 "#b8b9d7"
    }

    // == Pane frames ==
    frame_selected {
      base "#8da7d1"
      background "#1a1a19"
      emphasis_0 "#b8b9d7"
      emphasis_1 "#5ba7c5"
      emphasis_2 "#91ab78"
      emphasis_3 "#ec7470"
    }
    frame_highlight {
      base "#b8b9d7"
      background "#1a1a19"
      emphasis_0 "#8da7d1"
      emphasis_1 "#5ba7c5"
      emphasis_2 "#91ab78"
      emphasis_3 "#ec7470"
    }

    // == Exit codes ==
    exit_code_success {
      base "#91ab78"
      background "#1a1a19"
      emphasis_0 "#5ba7c5"
      emphasis_1 "#8da7d1"
      emphasis_2 "#b8b9d7"
      emphasis_3 "#ec7470"
    }
    exit_code_error {
      base "#ec7470"
      background "#1a1a19"
      emphasis_0 "#b8b9d7"
      emphasis_1 "#5ba7c5"
      emphasis_2 "#91ab78"
      emphasis_3 "#8da7d1"
    }

    // == Collaborators ==
    multiplayer_user_colors {
      player_1 "#8da7d1"
      player_2 "#5ba7c5"
      player_3 "#91ab78"
      player_4 "#ce9db9"
      player_5 "#b8b9d7"
      player_6 "#b8b9d7"
      player_7 "#ec7470"
      player_8 "#70b2a5"
      player_9 "#6cb7c0"
      player_10 "#ddc7c2"
    }
  }
}
